# Local development uses SQLite when DATABASE_URL is not set.
DATABASE_PATH=data/incidents.db
# For PostgreSQL, uncomment and set a valid PostgreSQL URL:
# DATABASE_URL=postgresql://user:password@localhost:5432/incidents
ALLOWED_HTTPS_HOSTS=example.com
PROBE_TIMEOUT_SECONDS=5
AI_PIPE_TOKEN=replace-with-private-token
AI_PIPE_MODEL=openai/gpt-4.1-nano
AI_PIPE_CHAT_URL=https://aipipe.org/openai/v1/chat/completions
OPERATOR_API_KEY=replace-with-long-random-secret



